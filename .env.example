# ============================================================================
# Family Insurance & Subscription Hub - NAS Docker Konfiguration
# ============================================================================
# Kopiere diese Datei zu .env und passe die Werte bei Bedarf an:
# cp .env.example .env

# --- PocketBase (Backend & SQLite Datenbank) ---
# Optional: Kann leer gelassen werden! 
# Die Web-App verbindet sich im Browser automatisch mit der Host-IP/Domain deines NAS auf Port 8090.
# Nur ausfüllen, wenn du einen Reverse Proxy (z. B. https://pb.deine-domain.de) verwendest:
# NEXT_PUBLIC_POCKETBASE_URL=http://192.168.178.50:8090
POCKETBASE_INTERNAL_URL=http://pocketbase:8090

# --- Paperless-ngx Integration ---
# Interne NAS-URL für den Next.js Server-Proxy (z. B. IP deines NAS oder Docker-Containername)
PAPERLESS_URL=http://192.168.178.50:8000

# Öffentliche Browser-URL für Links ("In Paperless öffnen")
NEXT_PUBLIC_PAPERLESS_PUBLIC_URL=http://192.168.178.50:8000

# Dein Paperless-ngx API-Token (unter Paperless -> Einstellungen -> API-Token erstellen)
PAPERLESS_TOKEN=dein_paperless_api_token_hier

# --- Backup Konfiguration ---
# Wie viele Tage automatische tägliche SQLite-Backups im Ordner ./backups aufbewahrt werden
BACKUP_RETENTION_DAYS=30
